{{- if .OriginalInitPath -}}
if [ -f {{ .OriginalInitPath }} ]; then
  . "{{ .OriginalInitPath }}"
fi
{{ end -}}


if [ -z "$KL_NO_PROMPT" ]; then
# if depth != "1"  then 
  if [ "1" != "$KL_DEPTH" ]; then
    var1=" - $KL_DEPTH"
  fi
  KL_PROMPT="(kl$var1)"

  export PS1="
$KL_PROMPT $PS1"
fi

working_dir="$(pwd)"
cd "{{ .ProjectDir }}" || exit

cd "$working_dir" || exit

export PATH="$KL_NIX_PATH:$PATH"

alias reload='eval "$(kl shell --onlyprint)"'
